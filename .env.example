# Local development with npm run dev; the browser opens http://localhost:5173.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://ctokodnomy:change_this_password@127.0.0.1:5432/ctokodnomy
MEDIA_DIR=data/uploads

# Compose production values. Set APP_ORIGIN above to https://your-real-domain.
# Use a different generated password; hexadecimal characters need no URL escaping.
POSTGRES_USER=ctokodnomy
POSTGRES_DB=ctokodnomy
POSTGRES_PASSWORD=change_this_password
COMPOSE_PROJECT_NAME=ctokodnomy
APP_PORT=3000

# Tests MUST use a separate database, never the live event database.
# DATABASE_URL_TEST=postgresql://ctokodnomy:change_this_password@127.0.0.1:5432/ctokodnomy_test
